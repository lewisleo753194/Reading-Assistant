{
  "name": "reading-assistant",
  "description": "支持 PDF、图片、区域选择与视觉 AI 分析的桌面阅读助手",
  "author": "xyLee",
  "maintainers": [
    "LewisLeo44"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lewisleo753194/Reading-Assistant.git"
  },
  "bugs": {
    "url": "https://github.com/lewisleo753194/Reading-Assistant/issues"
  },
  "homepage": "https://github.com/lewisleo753194/Reading-Assistant#readme",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "version": "2.5.1",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "prepare:pdf-assets": "node scripts/sync-pdfjs-assets.mjs",
    "dev": "npm run prepare:pdf-assets && concurrently -k \"vite\" \"node --watch server/index.mjs\"",
    "build": "npm run prepare:pdf-assets && tsc -b && vite build",
    "test:codex": "node --test tests/codex-app-server.test.mjs tests/ai-compatible-regression.test.mjs tests/responses-file-search.test.mjs tests/project-ui-regression.test.mjs tests/streaming-ui-regression.test.mjs tests/upgrade-250.test.mjs tests/selection-ocr-regression.test.mjs tests/conversation-attachments.test.mjs tests/storage-manager.test.mjs tests/pdf-full-processing-regression.test.mjs tests/codex-runtime.test.mjs",
    "preview": "node server/index.mjs",
    "lint": "eslint .",
    "desktop": "npm run build && electron .",
    "desktop:test": "npm run build && electron . --development-instance",
    "desktop:pack": "npm run build && electron-builder --win nsis",
    "desktop:portable": "npm run build && electron-builder --win portable --config.win.artifactName=Raid-Portable-${version}.${ext}",
    "desktop:dir": "npm run build && electron-builder --win dir"
  },
  "build": {
    "appId": "cn.lxymol.readingassistant",
    "productName": "Raid",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release-2.5.1"
    },
    "extraResources": [
      {
        "from": "electron/app-icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/app-icon.ico",
      "electronLanguages": [
        "en-US",
        "zh-CN"
      ],
      "artifactName": "Raid-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Raid",
      "installerIcon": "electron/app-icon.ico",
      "uninstallerIcon": "electron/app-icon.ico",
      "installerHeaderIcon": "electron/app-icon.ico"
    }
  },
  "dependencies": {
    "dotenv": "latest",
    "express": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "katex": "^0.18.4",
    "lucide-react": "latest",
    "pdfjs-dist": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tesseract.js": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest"
  }
}
